PORT=3001

# Google Drive + Sheets (optional): path to service-account JSON from Google Cloud Console.
# Share your target Drive folder + the Form responses spreadsheet with the service account email.
# GOOGLE_APPLICATION_CREDENTIALS=E:/secrets/my-sa.json

# Copy to `.env`. This app persists match state in `./data/*.json`.
# Postgres is optional: `docker compose up -d` starts a DB you can attach later if you migrate to PostgreSQL.

# DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/bgmi_overlay
