# Optional: Socket.IO connects directly here in Vite dev/preview (avoids ws-proxy noise).
# If unset: localhost pages use http://127.0.0.1:3001; opening the UI via LAN IP (e.g. http://192.168.1.5:5173)
# automatically uses http://<same-host>:3001 so OBS on another PC can receive live updates.
# Override only for tunnels / unusual setups:
# VITE_DEV_SOCKET_ORIGIN=http://127.0.0.1:3001
#
# Optional: pin API origin instead of dev proxy (/api → Node :3001)
# VITE_API_URL=http://127.0.0.1:3001
#
# Optional: full origin for OBS URL hints (Theme Preview clipboard rows) when UI is tunnelled
# VITE_PUBLIC_UI_ORIGIN=https://your-tunnel.example.com
